# Copy to .env and adjust if your AnkiConnect setup is non-default.

# Where AnkiConnect listens (default is fine for a local Anki Desktop).
ANKI_CONNECT_URL=http://127.0.0.1:8765

# Only set this if you configured an apiKey in the AnkiConnect add-on config.
# ANKI_CONNECT_API_KEY=

# Request timeout in seconds.
ANKI_CONNECT_TIMEOUT=15
